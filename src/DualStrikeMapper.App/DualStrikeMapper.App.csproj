<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DualStrikeMapper</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Name shown in the exe's file properties and in Task Manager. -->
    <Product>Sidewinder Dual Strike Input Mapper</Product>
    <AssemblyTitle>Sidewinder Dual Strike Input Mapper</AssemblyTitle>
    <!-- File name of the published program on every platform. AssemblyName stays DualStrikeMapper
         because the avares://DualStrikeMapper/... asset URIs depend on it; a single-file program can be
         renamed safely. -->
    <PublishedAppName>Sidewinder Dual Strike Input Mapper</PublishedAppName>
  </PropertyGroup>

  <!-- `dotnet publish -r <rid>` makes one standalone file that runs without .NET installed. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <!-- Debug symbols (SkiaSharp ships ~100 MB of them) aren't needed by players. -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- Give the published single-file program its full name (Windows, Linux and macOS). -->
  <Target Name="RenamePublishedApp" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_ExeExt Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</_ExeExt>
      <_PublishedExe>$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName)$(_ExeExt)'))</_PublishedExe>
      <_RenamedExe>$([System.IO.Path]::Combine('$(PublishDir)', '$(PublishedAppName)$(_ExeExt)'))</_RenamedExe>
    </PropertyGroup>
    <Delete Files="$(_RenamedExe)" />
    <Move SourceFiles="$(_PublishedExe)" DestinationFiles="$(_RenamedExe)" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DualStrikeMapper.Core\DualStrikeMapper.Core.csproj" />
  </ItemGroup>
</Project>
